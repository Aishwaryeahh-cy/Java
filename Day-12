            expr++,expr--,+ , - !, ~, (type)   Left to Right 
            * , / , +, - (binary)              Right to Left
            << , >> ,>>                        Left to Right
            <,<=,>,>=,instanceof               Left to Right
            ==,!=                              Left to Right
            &                                  Left to Right
            ^                                  Left to Right
            |                                  Left to Right
            &&                                 Left to Right
            ||                                 Left to Right
            ?: (Ternary)                       Right to Left

Lowest      '=','+=','-=','*=','/=','%='       Right to Left

